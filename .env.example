# Optional. Copy to backend/.env. Never commit .env.
# Without any key ScamShield uses its built-in rule-based engine (fully functional).
# With ONE of these keys an AI "second opinion" is blended into the score. Keys stay on the server.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ALLOWED_ORIGIN=https://<your-username>.github.io
# PORT=8000
# RATE_LIMIT_PER_MIN=60
